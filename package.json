{
  "name": "ot-baza",
  "private": true,
  "version": "1.4.0",
  "description": "ОТ-База — автономное приложение для ведения баз данных по охране труда: таблицы со связями, импорт Excel, генерация DOCX/PDF по тегам, контроль сроков, готовность к проверке ГИТ и локальная LLM-студия.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run && vite build"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "docx": "^9.15.3",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
