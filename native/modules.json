  "templates": [
    {
      "id": "tpl_hire_order",
      "name": "Приказ о приёме на работу",
      "category": "Приказы",
      "content": "ПРИКАЗ № {Номер} от {Дата_события}\n\n{Организация} (ИНН {ИНН})\n\nО ПРИЁМЕ НА РАБОТУ\n\nПРИНЯТЬ {ФИО} на должность {Должность} в подразделение {Подразделение} с {Дата_приёма}.\nУстановить должностной оклад согласно штатному расписанию.\nОснование: трудовой договор.\n\nДиректор ____________________ {Директор}\n\nС приказом ознакомлен(а): ______________ {ФИО}"
    },
    {
      "id": "tpl_transfer_order",
      "name": "Приказ о переводе на другую работу",
      "category": "Приказы",
      "content": "ПРИКАЗ № {Номер} от {Дата_события}\n\n{Организация} (ИНН {ИНН})\n\nО ПЕРЕВОДЕ НА ДРУГУЮ РАБОТУ\n\nПЕРЕВЕСТИ {ФИО} с прежней должности {Должность} на новую должность с {Дата_события}.\nОснование: соглашение сторон трудового договора.\n\nДиректор ____________________ {Директор}\n\nС приказом ознакомлен(а): ______________ {ФИО}"
    },
    {
      "id": "tpl_dismissal_order",
      "name": "Приказ о прекращении трудового договора",
      "category": "Приказы",
      "content": "ПРИКАЗ № {Номер} от {Дата_события}\n\n{Организация} (ИНН {ИНН})\n\nО ПРЕКРАЩЕНИИ ТРУДОВОГО ДОГОВОРА\n\nУВОЛИТЬ {ФИО}, должность {Должность}, {Дата_события}.\nОснование: заявление работника, пункт 3 части 1 статьи 77 ТК РФ.\n\nДиректор ____________________ {Директор}\n\nС приказом ознакомлен(а): ______________ {ФИО}"
    },
    {
      "id": "tpl_incident_act",
      "name": "Акт о несчастном случае на производстве",
      "category": "Несчастные случаи",
      "content": "АКТ № {Номер} от {Дата_события}\n\n{Организация} (ИНН {ИНН})\n\nО НЕСЧАСТНОМ СЛУЧАЕ НА ПРОИЗВОДСТВЕ\n\nПострадавший: {ФИО}, должность {Должность}, подразделение {Подразделение}.\nДата происшествия: {Дата_события}.\nОбстоятельства: установлены комиссией по расследованию.\n\nПредседатель комиссии ____________________ {Директор}"
    },
    {
      "id": "tpl_med_referral",
      "name": "Направление на медицинский осмотр",
      "category": "Медосмотры и МО",
      "content": "НАПРАВЛЕНИЕ НА МЕДИЦИНСКИЙ ОСМОТР\n\n{Организация} (ИНН {ИНН})\n\nРаботник: {ФИО}\nДолжность: {Должность}\nПодразделение: {Подразделение}\nДата приёма: {Дата_приёма}\n\nНаправляется на медицинский осмотр в соответствии с Приказом Минздрава РФ № 29н.\nДата: {Дата_события}\n\nРуководитель ____________________ {Директор}"
    },
    {
      "id": "tpl_siz_card",
      "name": "Личная карточка учёта выдачи СИЗ",
      "category": "Выдача СИЗ",
      "content": "ЛИЧНАЯ КАРТОЧКА УЧЁТА ВЫДАЧИ СИЗ\n\n{Организация} (ИНН {ИНН})\n\nРаботник: {ФИО}\nТабельный номер: {Табельный}\nДолжность: {Должность}\nПодразделение: {Подразделение}\n\nВыдано: комплект СИЗ согласно нормам Приказа Минтруда РФ № 766н.\nДата выдачи: {Дата_события}\n\nОтветственный ____________________ {Директор}"
    },
    {
      "id": "tpl_protocol_knowledge",
      "name": "Протокол проверки знаний требований охраны труда",
      "category": "Инструктажи и протоколы",
      "content": "ПРОТОКОЛ № {Номер} от {Дата_события}\n\n{Организация} (ИНН {ИНН})\n\nПРОВЕРКА ЗНАНИЙ ТРЕБОВАНИЙ ОХРАНЫ ТРУДА\n\nПроверяемый: {ФИО}, должность {Должность}.\nРезультат: знания требований охраны труда подтверждены.\nОснование: Постановление Правительства РФ № 2464.\n\nПредседатель комиссии ____________________ {Директор}"
    }
  ]}
